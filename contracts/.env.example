# contracts/.env.example
# Workspace-local environment variables for the Stockroom contracts workspace.
# This is separate from the frontend's .env.example at the repo root.
#
# Copy this file to contracts/.env and fill in values before running any
# `deploy:testnet` / `deploy:mainnet` script. Never commit contracts/.env.

# RPC endpoint for Robinhood Chain testnet (chain id 46630).
ROBINHOOD_TESTNET_RPC_URL=

# RPC endpoint for Robinhood Chain mainnet (chain id 4663).
ROBINHOOD_MAINNET_RPC_URL=

# Private key used ONLY by contracts/scripts/deploy.ts for the contracts
# team's own manual testnet/local deployments and testing. This is a
# local/testnet-only convenience — the running Stockroom application NEVER
# reads this variable and never holds a deployment key. Production token
# deployments happen from the end user's own connected wallet in the
# frontend, not from this workspace or any server process.
DEPLOYER_PRIVATE_KEY=
