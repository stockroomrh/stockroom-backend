# Supabase (Postgres + Auth). Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WalletConnect (mobile/QR-code wallet connections). Get a free project ID at
# https://cloud.walletconnect.com — omit to hide the WalletConnect option and
# only offer browser-extension wallets (MetaMask, Brave, etc.).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Robinhood Chain. 46630 = testnet, 4663 = mainnet. Start on testnet.
NEXT_PUBLIC_CHAIN_ID=46630
# Testnet and mainnet each need their OWN block explorer var — both
# lib/server/chain/blockscout.ts and lib/chain-config.ts pick between them
# based on NEXT_PUBLIC_CHAIN_ID above. Setting only one and expecting it to
# cover both chains was a real bug (live mode silently read testnet data).
NEXT_PUBLIC_BLOCK_EXPLORER_URL=
NEXT_PUBLIC_MAINNET_BLOCK_EXPLORER_URL=
# Public-safe RPC used by the browser wallet (wagmi transport). Use a public/community
# endpoint here, never a key-bearing URL — that belongs server-side only, below.
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=
# Server-only Alchemy RPC for indexing/reads. lib/server/chain/client.ts picks
# between these two based on NEXT_PUBLIC_CHAIN_ID (same testnet/mainnet split
# as the explorer vars above — this used to be hardcoded to the testnet var
# only, so live mode silently read testnet chain data for treasury syncing).
ALCHEMY_ROBINHOOD_RPC_URL=
# Also used standalone for reading Pons's live launch-factory config (Pons has
# no testnet deployment — required for live token launches via Pons; leave
# empty to disable that feature gracefully).
ALCHEMY_ROBINHOOD_MAINNET_RPC_URL=

# Trading (0x Swap API v2). Never expose to the browser.
ZEROX_API_KEY=

# Treasury Agent (Anthropic). Never expose to the browser.
ANTHROPIC_API_KEY=

# Secret for app/api/cron/weekly-report and app/api/cron/telegram-alerts —
# Vercel Cron sends this automatically as "Authorization: Bearer $CRON_SECRET"
# once set (see vercel.json for the schedules). Any other scheduler must send
# the same header. Generate with e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Telegram treasury alerts. Create a bot via @BotFather in Telegram to get
# the token and username, then register the webhook once:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=<your-domain>/api/telegram/webhook&secret_token=$TELEGRAM_WEBHOOK_SECRET"
# Never expose the token or webhook secret to the browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Telegram launch bot — a SEPARATE bot from the operator alerts bot above.
# Create a second bot via @BotFather, then register its webhook once:
#   curl "https://api.telegram.org/bot$TELEGRAM_LAUNCH_BOT_TOKEN/setWebhook?url=<your-domain>/api/telegram/launch-webhook&secret_token=$TELEGRAM_LAUNCH_WEBHOOK_SECRET"
# Walks an operator through creating a brand new Stockroom project from
# chat; the final wallet signature always happens on stockroom.finance
# (/app/launch?draft=<token>), never inside Telegram.
TELEGRAM_LAUNCH_BOT_TOKEN=
TELEGRAM_LAUNCH_BOT_USERNAME=
TELEGRAM_LAUNCH_WEBHOOK_SECRET=

# App mode / rollout flags
NEXT_PUBLIC_FLAGSHIP_PROJECT_SLUG=stockroom
NEXT_PUBLIC_ENABLE_LIVE_MODE=false
NEXT_PUBLIC_ENABLE_TRADING=false

# Canonical base assets (from Robinhood Chain config, not hardcoded elsewhere)
USDG_ADDRESS=
WETH_ADDRESS=
